
ViewSize=3200,2400
LockViewpoint = true

' Permettre de placer des objets "a droite", "a gauche", un peu comme centered

{Layers
  [*************** PARALAX bloqué **************]
  [
    [Picture
      RessourceFile = @"./layerC.png"
    ]
  ],
  [
    [Picture
      RessourceFile = @"./layerB.png"
    ]
  ],
  [
    [Picture
      RessourceFile = @"./layerA.png"
    ]
  ],
  [* *********** TEXTURE BOUCLANTE ************]

  [
    [Picture
      RessourceFile = @"./tile.png"
      Scale = 1.0, 1.0
      ColorMask = 255, 255, 255, 128
    ]
    Loop = true, true
    Mode = "Center"
    Speed = 0.5, 0.5
  ],
  [
    [Picture
      RessourceFile = @"./tile.png"
      Scale = 1.5, 1.5
      ColorMask = 255, 255, 255, 128
    ]
    Loop = true, true
    Mode = "Center"
    Speed = 1.0, 1.0
  ],
  
  [* *********** TEXTURE FIXE ************]  
  [
    [Picture
      RessourceFile = @"./background.png"
      Scale = 1.0, 1.0
      ColorMask = 255, 255, 255, 128
    ]
    'Occupe 100% de la viewsize du parralax. Si l'image est plus petite,
    'cela fera mosaique
    Loop = true, true
    'Local indique la reference est le clipable et non l'espace virtuel
    'donc, pas de camera
    Local = true
    Mode = "Center"
  ]
}
